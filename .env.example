# ============================================================
# Bal Suraksha — environment configuration template
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to git.
# ============================================================

# ── Runtime modes ──────────────────────────────────────────
# APP_MODE: demo | beta | production
APP_MODE=demo

# NOTIFICATION_MODE: DISABLED | TEST_ALLOWLIST | LIVE
# demo + LIVE is an INVALID combination — the server will refuse to start.
NOTIFICATION_MODE=DISABLED

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgres://balsuraksha:balsuraksha@localhost:5454/balsuraksha?sslmode=disable

# MIGRATION_PATH: absolute path to db/migrations directory.
# Empty = skip auto-migration (safe when DB is already migrated).
# In Docker: /app/db/migrations  (set via docker-compose environment).
# Local dev:  leave empty after first run, or set to absolute path.
MIGRATION_PATH=

# ── Redis (optional — for rate limiting / temp state) ──────
REDIS_URL=redis://localhost:6379

# ── API server ─────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0

# ── Worker ─────────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=5
ESCALATION_THRESHOLD_MINUTES=60
ALERT_EXPIRY_CHECK_INTERVAL_SECONDS=30

# ── Session signing (JWT) ──────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_THIS_IN_PRODUCTION_openssl_rand_hex_32

# ── Staff auth: Keycloak OIDC; local passwords are demo-only ──
STAFF_AUTH_MODE=demo
OIDC_ISSUER=
OIDC_AUDIENCE=balsuraksha-api
OIDC_CLIENT_ID=balsuraksha-ops
# For browser builds, set VITE_API_BASE_URL in apps/ops/.env.local.
# Provision issuer+subject mappings using docs/11-reuse-and-authentication.md.
STAFF_JWT_EXPIRY_HOURS=8

# ── Assessment feature ───────────────────────────────────
# Demo mode uses clearly labeled synthetic responses. Beta/production return
# unavailable until an eligible child-facing provider is approved.
# AI_ENABLED=true is rejected; a Gemini key never enables this child-facing API.
# Gemini may still be used separately as an adult developer's coding assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10
AI_ENABLED=false

# ── Web Push — VAPID (RFC 8292 / RFC 8030) ────────────────────────────────
# VAPID key pair for sending Web Push notifications.
# Generate with: npx web-push generate-vapid-keys --json
# VAPID_PRIVATE_KEY: 32-byte P-256 private key scalar (base64url, no padding)
# VAPID_PUBLIC_KEY:  65-byte uncompressed P-256 public key (base64url, no padding)
# VAPID_SUBJECT:     contact URI for the push service (mailto: or https:)
# If absent, the stub provider is used (sends are simulated, clearly labeled).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:alerts@balsuraksha.org

# ── TEST allowlist controls ────────────────────────────────
TEST_ALLOWLIST_MAX=20
TEST_ENROLLMENT_CODE=
# Exact browser origins, comma separated; no wildcard credentialed CORS.
WEB_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
TEST_CAMPAIGN_REVISION_CAP=3
TEST_CUMULATIVE_RECIPIENT_CAP=60

# ── Return secret (BIP-39, 4 words) ───────────────────────
# Word count for the mnemonic return secret shown to users.
RETURN_SECRET_WORD_COUNT=4
