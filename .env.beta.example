# Copy to .env.beta.local. Never commit the completed file.
PUBLIC_HOST=replace-with-your-domain
POSTGRES_PASSWORD=replace-with-generated-password
DATABASE_URL=postgres://balsuraksha:replace-with-generated-password@postgres:5432/balsuraksha?sslmode=disable
SESSION_SECRET=CHANGE_THIS_GENERATE_AT_LEAST_32_RANDOM_BYTES
OIDC_ISSUER=https://replace-with-identity-host/realms/balsuraksha
OIDC_AUDIENCE=balsuraksha-api
OIDC_CLIENT_ID=balsuraksha-ops
BETA_INTAKE_ENABLED=false
BETA_INVITATION_CODE=
BETA_ENTRY_POINT_ID=
NOTIFICATION_MODE=DISABLED
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-operator-email
AI_ENABLED=false
