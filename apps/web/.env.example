# ============================================================
# apps/web — Vite environment variables
# Copy this file to .env and fill in values for your deployment.
# NEVER commit .env to git.
#
# These variables are BAKED IN at build time by Vite.
# To change them after deployment you must rebuild.
# ============================================================

# ── API ──────────────────────────────────────────────────────
# Base URL of the Bal Suraksha API (no trailing slash).
# Local dev default: http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ── Cross-app links ──────────────────────────────────────────
# URL of the Ops / Staff console. Used for the "Staff sign in" link.
# Local dev default: http://localhost:5174
# Production example: https://ops.balsuraksha.org
VITE_OPS_URL=http://localhost:5174
