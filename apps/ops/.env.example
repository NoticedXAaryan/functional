# ============================================================
# apps/ops — Vite environment variables
# Copy this file to .env and fill in values for your deployment.
# NEVER commit .env to git.
#
# These variables are BAKED IN at build time by Vite.
# To change them after deployment you must rebuild.
# ============================================================

# ── API ──────────────────────────────────────────────────────
# Base URL of the Bal Suraksha API (no trailing slash).
# Local dev default: http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ── Cross-app links ──────────────────────────────────────────
# URL of the public / child-facing web app. Used for "Public home" and
# "Local alerts" links in the staff console header.
# Local dev default: http://localhost:5173
# Production example: https://app.balsuraksha.org
VITE_PUBLIC_URL=http://localhost:5173

# ── Post-login redirect (optional) ───────────────────────────
# When set, a "Continue to <URL>" button appears after staff sign in,
# allowing staff to proceed to an external dashboard or admin portal.
# Leave empty to stay in the ops console after login (default).
# Example: https://admin.balsuraksha.org
VITE_POST_LOGIN_REDIRECT_URL=
